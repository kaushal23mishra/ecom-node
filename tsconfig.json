{
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "dist",
    "module": "CommonJS",
    "target": "es2020",
    "moduleResolution": "Node",
    "lib": ["es2020"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": false,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*", "__test__/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "public",
    "scripts",
    "jest.config.js"
  ]
}
